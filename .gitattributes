# Store text with LF and keep LF on checkout (the files already use LF;
# Python, Git and VS Code all handle LF on Windows).
* text=auto eol=lf

# Benchmark evidence is verified by SHA-256 manifests, so Git must store and
# check it out byte-for-byte (no line-ending conversion).
benchmarks/** -text
*.sha256 -text
*.jsonl -text
