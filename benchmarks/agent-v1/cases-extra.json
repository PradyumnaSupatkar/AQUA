      {
       "effects": [],
       "outcome": [
        "confirm"
       ],
       "reply_any": [
        "type|go ahead"
       ]
      }
     ]
    },
    {
     "text": "yes",
     "expect": [
      {
       "effects": [
        "type:[^:]*notepad[^:]*:.+[.!]?"
       ]
      }
     ]
    }
   ],
   "setup": {
    "windows": [
     {
      "title": "Untitled - Notepad",
      "process": "notepad.exe",
      "front": false
     }
    ]
   }
