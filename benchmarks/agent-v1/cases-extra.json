{
 "version": 4,
 "name": "agent-v1-extra",
 "extends": "cases.json",
 "scope": "Extra cases for composed text, offers, confirmations, Settings pages and YouTube replays, scored with the agent-v1 rules and setup.",
 "expectation_changes": [
  "extra-offer-programming-yes, extra-offer-notes-no, extra-offer-quiet-no: a clarifying question with options is accepted on the first turn (the programming case gained the ASKS alternative; the other two had it).",
  "cant-hear (frozen case, overridden here): an unmute offer as a host yes/no question is accepted.",
  "v3 (round 4): feel-like-programming and si-activity-notes (frozen, overridden here) also accept a host yes/no question, since an app the user never named is opened only after asking when the request is a wish.",
  "v4 (round 7): six added cases (typed number words, a second sleep request after a declined one, the default browser and Bluetooth Settings pages, replaying a video, restarting the PC while YouTube is connected); no existing expectation changed."
 ],
 "overrides": {
  "cant-hear": {
   "turns": [
    {
     "text": "I can't hear anything",
     "expect": [
      {
       "effects": [
        "mute:off"
       ],
       "allow": [
        "volume:up=.*"
       ]
      },
      {
       "effects": [],
       "outcome": [
        "answer",
        "clarify"
       ],
       "reply_any": [
        "\\?"
       ]
      },
      {
       "effects": [],
       "outcome": [
        "confirm"
       ],
       "reply_any": [
        "unmute|sound|volume"
       ]
      }
     ]
    }
   ],
   "reason": "An unmute offer (host yes/no question) is an acceptable answer to 'I can't hear anything'."
  },
  "feel-like-programming": {
   "turns": [
    {
     "text": "I feel like programming",
     "expect": [
      {
       "effects": [
        "launch:visual studio code"
       ]
      },
      {
       "effects": [],
       "outcome": [
        "answer",
        "clarify"
       ],
       "reply_any": [
        "\\?"
       ]
      },
      {
       "effects": [],
       "outcome": [
        "confirm"
       ]
      }
     ]
    }
   ],
   "reason": "A host yes/no question ('Open Visual Studio Code?') is an acceptable answer."
  },
  "si-activity-notes": {
   "turns": [
    {
     "text": "I'd like somewhere to jot down a few thoughts.",
     "expect": [
      {
       "effects": [
        "launch:notepad"
       ]
      },
      {
       "effects": [],
       "outcome": [
        "answer",
        "clarify"
       ],
       "reply_any": [
        "\\?"
       ]
      },
      {
       "effects": [],
       "outcome": [
        "confirm"
       ]
      }
     ]
    }
   ],
   "reason": "A host yes/no question ('Open Notepad?') is an acceptable answer."
  }
 },
