   "setup": {
    "memory": {
     "browser": [
      [
       "youtube.com",
       "Brave"
      ],
      [
       "",
       "Chrome"
      ]
     ]
    },
    "apps": [
     [
      "Brave",
      "C:\\ProgramData\\Start Menu\\Brave.lnk",
      "shortcut",
      "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
     ]
    ]
   }
  },
  {
   "id": "mem-route-explicit",
   "category": "memory",
   "turns": [
    {
     "text": "open youtube in chrome",
     "expect": [
      {
       "effects": [
        "url:https://(www\\.)?youtube\\.com/?",
        "open-in:google chrome"
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {
     "browser": [
      [
       "youtube.com",
       "Brave"
      ],
      [
       "",
       "Chrome"
      ]
     ]
    },
    "apps": [
     [
      "Brave",
      "C:\\ProgramData\\Start Menu\\Brave.lnk",
      "shortcut",
      "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
     ]
    ]
   }
  },
  {
   "id": "mem-use-fact",
   "category": "memory",
   "turns": [
    {
     "text": "where are my projects?",
     "expect": [
      {
       "effects": [],
       "reply_any": [
        "d:\\\\projects"
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {
     "facts": [
      "My projects are in D:\\Projects"
     ]
    }
   }
  },
  {
   "id": "mem-recall",
   "category": "memory",
   "turns": [
    {
     "text": "what do you remember about me?",
     "expect": [
      {
       "effects": [],
       "reply_any": [
        "(?s)(?=.*projects)(?=.*pune)"
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {
     "facts": [
      "My projects are in D:\\Projects",
      "I live in Pune"
     ]
    }
   }
  },
  {
   "id": "mem-forget-that",
   "category": "memory",
   "turns": [
    {
     "text": "forget that",
     "expect": [
      {
       "effects": [
        "memory:forget=i live in pune."
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {
     "facts": [
      "My projects are in D:\\Projects",
      "I live in Pune"
     ]
    }
   }
  },
  {
   "id": "mem-forget-all",
   "category": "memory",
   "turns": [
    {
     "text": "forget everything you remember about me",
     "expect": [
      {
       "effects": [],
       "outcome": [
        "confirm"
       ]
      }
     ]
    },
    {
     "text": "yes",
     "expect": [
      {
       "effects": [
        "memory:clear"
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {
     "facts": [
      "My projects are in D:\\Projects",
      "I live in Pune"
     ]
    }
   }
  },
