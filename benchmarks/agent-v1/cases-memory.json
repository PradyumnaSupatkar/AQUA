{
 "version": 1,
 "name": "agent-v1-memory",
 "extends": "cases.json",
 "scope": "Local memory for the new engine: automatic remember, browser routing applied by the host, forget, recall, and refusals (secrets, sensitive details, page text).",
 "cases": [
  {
   "id": "mem-fact-projects",
   "category": "memory",
   "turns": [
    {
     "text": "remember that my projects are in D:\\Projects",
     "expect": [
      {
       "effects": [
        "memory:fact=.*projects are in d:\\\\projects\\."
       ],
       "reply_any": [
        "remember"
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {}
   }
  },
  {
   "id": "mem-fact-plain",
   "category": "memory",
   "turns": [
    {
     "text": "my dog is called Max",
     "expect": [
      {
       "effects": [
        "memory:fact=.*dog is called max\\."
       ]
      },
      {
       "effects": [],
       "outcome": [
        "answer",
        "clarify"
       ],
       "reply_any": [
        "\\?"
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {}
   }
  },
  {
   "id": "mem-browser-pref",
   "category": "memory",
   "turns": [
    {
     "text": "always open YouTube in Brave and Chrome for anything else",
     "expect": [
      {
       "effects": [
        "memory:browser=youtube.com:brave",
        "memory:browser=:chrome"
       ],
       "reply_any": [
        "brave"
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {}
   }
  },
  {
   "id": "mem-pref-not-acted",
   "category": "memory",
   "turns": [
    {
     "text": "from now on open youtube in brave",
     "expect": [
      {
       "effects": [
        "memory:browser=youtube.com:brave"
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {}
   }
  },
  {
   "id": "mem-route-youtube",
   "category": "memory",
   "turns": [
    {
     "text": "open youtube",
     "expect": [
      {
       "effects": [
        "url:https://(www\\.)?youtube\\.com/?",
        "open-in:brave"
       ]
      }
     ]
    }
   ],
   "setup": {
    "memory": {
     "browser": [
      [
       "youtube.com",
       "Brave"
      ],
      [
       "",
       "Chrome"
      ]
     ]
    },
    "apps": [
     [
      "Brave",
      "C:\\ProgramData\\Start Menu\\Brave.lnk",
      "shortcut",
      "C:\\Program Files\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
     ]
    ]
   }
  },
  {
   "id": "mem-route-other",
   "category": "memory",
   "turns": [
    {
     "text": "open github.com",
     "expect": [
      {
       "effects": [
        "url:https://(www\\.)?github\\.com/?",
        "open-in:google chrome"
