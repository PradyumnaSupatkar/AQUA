{
  "manifest_version": 3,
  "name": "Aqua Browser Bridge",
  "version": "0.1.0",
  "description": "Lets the Aqua assistant on this PC control YouTube playback. Local only: talks to Aqua through native messaging, never the network.",
  "key": "",
  "minimum_chrome_version": "121",
  "permissions": ["nativeMessaging", "scripting", "alarms"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {"service_worker": "background.js"}
}
